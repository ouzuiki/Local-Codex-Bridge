{
  "profileId": "archify-admission-profile",
  "profileVersion": "1.0.0",
  "stage": "AR0",
  "description": "Worker-neutral admission profile for the Archify integration. Declares the policy contract that any future wrapper (AR1) and any calling worker (Codex/Claude/Pi, AR2) must enforce. This document does not implement enforcement; it defines what enforcement must do.",
  "upstream": {
    "identity": "tt-a1i/archify",
    "pin": "v2.16.0",
    "pinPolicy": "exact-version-only",
    "installation": {
      "controlledBy": "owner",
      "location": "outside-wrapper",
      "prohibited": [
        "npx-latest-resolution",
        "auto-install",
        "auto-update",
        "implicit-version-drift"
      ]
    }
  },
  "filesystem": {
    "reads": {
      "allowed": [
        "repository-or-source-files-needed-for-the-task",
        "git-metadata"
      ],
      "prohibited": [
        "credentials",
        "secrets"
      ]
    },
    "writes": {
      "allowedRoot": "dedicated-artifact-root-inside-target-cwd",
      "defaultArtifactRoot": ".artifacts/archify",
      "artifactRootOverride": {
        "allowed": true,
        "mustBe": "relative-path",
        "mustResolveInside": "target-cwd"
      }
    },
    "output": {
      "requiredExtension": ".html",
      "callerSuppliedRawFilesystemPaths": "prohibited",
      "rejectionRules": [
        "absolute-output-name",
        "parent-traversal-sequence",
        "artifact-root-escape",
        "symlink-escape",
        "non-html-output"
      ]
    }
  },
  "replacement": {
    "mechanism": "wrapper-controlled-same-directory-candidate",
    "promotionPreconditions": [
      "child-process-success",
      "basic-artifact-verification"
    ],
    "guarantee": "last-known-good-final-output-must-survive-child-failure-or-invalid-candidate"
  },
  "runtime": {
    "forcedEnv": {
      "ARCHIFY_UPDATE_CHECK_DISABLED": "1"
    },
    "network": "disabled-by-default",
    "updateCheck": "disabled-by-default",
    "autoInstall": false,
    "autoUpdate": false
  },
  "preview": {
    "openOrPreview": "disabled-by-default",
    "visualCheck": {
      "impliedByDeliver": false,
      "status": "separate-optional-capability",
      "requiresExplicitAuthorization": true
    }
  },
  "prohibitedActions": [
    "credential-or-secret-reads",
    "git-commit",
    "git-push",
    "service-or-process-mutation"
  ],
  "privacy": {
    "privateRepoOrSourceEvidence": {
      "defaultScope": "local-only",
      "autoPublish": false,
      "autoShare": false
    }
  },
  "claimDimensions": {
    "distinct": true,
    "dimensions": [
      "deterministic-schema-validation",
      "runtime-browser-evidence",
      "perceptual-review",
      "human-acceptance"
    ],
    "note": "Satisfying one dimension does not imply satisfaction of any other dimension. Each must be independently established when claimed."
  },
  "admissionPolicy": {
    "failureMode": "fail-closed",
    "onViolationOf": [
      "admission-policy",
      "path-policy",
      "runtime-policy"
    ]
  },
  "rationale": {
    "upstreamIssueReference": "tt-a1i/archify#124",
    "referenceScope": "cited only as the reason output confinement is independently enforced by this integration; the integration does not rely on upstream CLI output-path enforcement"
  }
}
