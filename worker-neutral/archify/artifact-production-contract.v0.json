{
  "contractId": "archify-artifact-production-contract",
  "contractVersion": "0.1.0",
  "stage": "AR3",
  "status": "pass",
  "description": "Worker-neutral, machine-readable production contract for Archify artifact delivery. Defines the state machine any wrapper (currently scripts/archify-safe.mjs) and any calling worker must satisfy for a delivery to be treated as a real, verifiable artifact. Extends worker-neutral/archify/admission-profile.v1.json; does not replace it.",
  "appliesTo": {
    "wrapperVersion": "1.0.0",
    "profileVersion": "1.0.0",
    "admissionProfileRef": "worker-neutral/archify/admission-profile.v1.json",
    "perWorkerImplementation": false
  },
  "runtimeGate": {
    "id": "A",
    "requirements": [
      "exact-approved-upstream-identity-and-pin-only (tt-a1i/archify, pinned exact version)",
      "runtime-path-must-be-local-explicit-and-absolute",
      "runtime-install-and-upgrade-controlled-by-owner-outside-wrapper",
      "wrapper-doctor-must-report-identityStatus=verified-and-detectedVersion-matching-expected-pin-before-any-deliver-is-trusted",
      "no-auto-fetch-no-auto-install-no-auto-update-ever"
    ],
    "failClosedIf": [
      "runtime_unavailable",
      "runtime_version_mismatch",
      "identityStatus!=verified"
    ]
  },
  "inputEvidence": {
    "id": "B",
    "requirements": [
      "receipt-must-record-spec.sha256-and-spec.bytes",
      "raw-spec-source-contents-excluded-from-receipt",
      "spec-file-is-read-only-from-wrapper-perspective (wrapper never mutates the spec)"
    ]
  },
  "outputConfinement": {
    "id": "C",
    "requirements": [
      "final-output-extension-must-be-.html",
      "output-root-is-a-dedicated-artifact-root-inside-the-target-cwd (default .artifacts/archify)",
      "caller-supplies-only-a-safe-relative-name (no-raw-arbitrary-filesystem-path)",
      "candidate-file-is-written-in-the-same-directory-as-the-final-path",
      "fail-closed-on-absolute-output-name",
      "fail-closed-on-parent-traversal-.._sequences",
      "fail-closed-on-symlink-escape-at-any-ancestor",
      "fail-closed-on-unsafe-final-target (existing-symlink-or-non-regular-file)",
      "last-known-good-final-output-preserved-unchanged-on-any-failure"
    ]
  },
  "promotionGate": {
    "id": "D",
    "requirements": [
      "child-process-exitCode-must-equal-0",
      "candidate-must-exist-be-a-regular-non-symlink-non-empty-file",
      "candidate-must-pass-basic-html-validation-before-promotion",
      "promotion-is-an-atomic-rename-of-candidate-to-final-path",
      "no-unlink-first-of-existing-final-output-ever"
    ]
  },
  "requiredReceiptFields": {
    "id": "E",
    "note": "Field names below are exact and aligned with scripts/archify-safe.mjs wrapper v1 output.",
    "fields": [
      "receiptVersion",
      "wrapperVersion",
      "profileVersion",
      "archify.pin",
      "archify.runtime",
      "archify.identityStatus",
      "archify.detectedVersion",
      "child.exitCode",
      "child.updateCheckDisabled",
      "finalRelativePath",
      "spec.sha256",
      "spec.bytes",
      "artifact.sha256",
      "artifact.bytes",
      "validation.basicArtifact",
      "claims.deterministicSchema",
      "claims.runtimeBrowser",
      "claims.perceptual",
      "claims.human"
    ],
    "excluded": [
      "source-contents",
      "secrets",
      "credentials"
    ]
  },
  "claimSemantics": {
    "id": "F",
    "principle": "A successful deliver with validation.basicArtifact=passed proves only that the child exited 0 and produced a non-empty, non-symlink, basic-HTML candidate that was atomically promoted. It does NOT imply schema validation, browser runtime evidence, perceptual quality, or human acceptance.",
    "dimensions": {
      "deterministicSchema": {
        "impliedByDeliver": false,
        "defaultValue": "not_separately_verified"
      },
      "runtimeBrowser": {
        "impliedByDeliver": false,
        "defaultValue": "not_performed"
      },
      "perceptual": {
        "impliedByDeliver": false,
        "defaultValue": "not_performed"
      },
      "human": {
        "impliedByDeliver": false,
        "defaultValue": "not_performed"
      }
    },
    "rule": "never-upgrade-not_performed-or-not_separately_verified-by-inference; each dimension requires independent, separately recorded evidence to change state"
  },
  "portabilityStatusSemantics": {
    "id": "G",
    "laneStatuses": ["pass", "hold", "fail"],
    "holdReasons": ["external_quota", "harness_capability", "runtime_unavailable"],
    "rules": [
      "artifact-validity-and-multi-worker-portability-are-separate-claims",
      "one-safe-lane-with-real-deliver-evidence-establishes-a-real-artifact-for-that-lane-only",
      "portable_across_all_workers-must-remain-false-until-every-required-lane-has-real-safe-deliver-evidence",
      "a-harness-safety-boundary-must-never-be-weakened-merely-to-turn-a-HOLD-into-a-PASS"
    ]
  },
  "privacyEvidence": {
    "id": "H",
    "requirements": [
      "private-or-source-derived-artifacts-and-evidence-are-local-only-by-default",
      "no-auto-publish-no-auto-share",
      "hashes-and-metadata-are-the-preferred-shareable-evidence-form"
    ]
  },
  "versionUpdatePolicy": {
    "id": "I",
    "requirements": [
      "contract-version-is-recorded-in-the-contract-document-and-in-any-AR-stage-or-evidence-document-that-references-it",
      "receipts-record-their-applicable-execution-identity-via-requiredReceiptFields (receiptVersion, wrapperVersion, profileVersion, archify.pin, archify.runtime) and-must-not-add-a-contractVersion-field",
      "evidence-documents-preserve-enough-version-references-to-relate-observed-evidence-back-to-the-contract-profile-wrapper-and-runtime-where-applicable",
      "any-runtime-pin-change-requires-re-admission-before-claims-carry-forward",
      "any-safety-behavior-change-in-the-wrapper-requires-re-smoke-before-claims-carry-forward"
    ]
  },
  "failureSemantics": {
    "id": "J",
    "rules": [
      "policy-violation-fails-closed (reject/abort, never silent-degrade)",
      "path-violation-fails-closed",
      "runtime-violation-fails-closed",
      "validation-violation-fails-closed",
      "child-process-failure-preserves-last-known-good-final-output",
      "a-HOLD-is-not-converted-to-a-failure-unless-the-worker-actually-executes-the-admitted-path-and-it-fails-for-an-integration-reason"
    ]
  }
}
