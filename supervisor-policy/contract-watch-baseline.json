{
  "schema_version": 1,
  "owner": "supervisor",
  "contract": "Tri-Bridge Contract v1",
  "as_of": "2026-09-04",
  "domains": [
    "native_api",
    "event_schema",
    "approval_semantics",
    "context_loading",
    "tool_catalog",
    "rate_limits"
  ],
  "workers": {
    "codex": {
      "required": [
        "native_api",
        "event_schema",
        "approval_semantics",
        "context_loading",
        "tool_catalog",
        "rate_limits"
      ],
      "notes": {
        "rate_limits": "LCB exposes account/rateLimits/read through codex_rate_limits."
      }
    },
    "pi": {
      "required": [
        "native_api",
        "event_schema",
        "approval_semantics",
        "context_loading",
        "tool_catalog"
      ],
      "optional": ["rate_limits"],
      "notes": {
        "rate_limits": "No mandatory LPB quota probe is frozen in Contract v1."
      }
    },
    "claude": {
      "required": [
        "native_api",
        "event_schema",
        "approval_semantics",
        "context_loading",
        "tool_catalog"
      ],
      "optional": ["rate_limits"],
      "notes": {
        "rate_limits": "No mandatory LClB quota probe is frozen in Contract v1."
      }
    }
  }
}
